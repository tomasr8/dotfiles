#!/usr/bin/env python
"""Show the number of user sessions running on each node

Install as a kubectl plugin:
    chmod +x kubectl-users && mv kubectl-users ~/.local/bin/
    kubectl users --totals
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from collections import defaultdict

NAMESPACE = "swan"
USER_POD_PREFIX = "jupyter-"

def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="kubectl users",
        description="Show the number of user sessions running on each node.",
    )
    parser.add_argument(
        "--totals", action="store_true", help="print a summary at the end"
    )
    return parser.parse_args(argv)


def fetch_pods() -> list[dict]:
    cmd = ("kubectl", "get", "pods", "-n", NAMESPACE, "-o", "json")
    proc = subprocess.run(cmd, capture_output=True, text=True, check=True)
    return json.loads(proc.stdout).get("items", [])



def node_name_sort_key(name: str) -> tuple[str, int]:
    n, index = name.rsplit("-", maxsplit=1)
    return (n, int(index))


def collect() -> list[dict]:
    counts = defaultdict(int)
    for pod in fetch_pods():
        node = pod.get("spec", {}).get("nodeName") or ""

        meta = pod.get("metadata", {})
        pod_name = meta.get("name", "")
        if not pod_name.startswith(USER_POD_PREFIX):
            continue

        counts[node or "<unscheduled>"] += 1

    rows = [{"node": node, "count": count} for node, count in counts.items()]
    rows.sort(key=lambda r: (-r["count"], *node_name_sort_key(r["node"])))
    return rows


def render(rows: list[dict]) -> None:
    if not rows:
        print("No user pods found.", file=sys.stderr)
        return

    cols = ("node", "count")
    header = [c.upper() for c in cols]
    table = [header] + [[str(row[c]) for c in cols] for row in rows]
    widths = [max(len(r[i]) for r in table) for i in range(len(cols))]
    for line in table:
        print("  ".join(cell.ljust(w) for cell, w in zip(line, widths)).rstrip())


def print_totals(rows: list[dict]) -> None:
    total = sum(r["count"] for r in rows)
    print(file=sys.stderr)
    print(f"total\t{total}", file=sys.stderr)


def main() -> None:
    args = parse_args()
    rows = collect()
    render(rows)
    if args.totals:
        print_totals(rows)


if __name__ == "__main__":
    main()
